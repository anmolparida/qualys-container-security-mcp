# --- Qualys ---
# Web app: whose Qualys data people see
#   service = everyone shares the account below (default for local use)
#   user    = each person signs in with their own Qualys URL + API token in the UI
QUALYS_AUTH_MODE=service

# Account used in service mode and by the local stdio MCP server.
# Give either an API token, or a username + password.
QUALYS_URL=https://gateway.qg1.apps.qualys.ca
QUALYS_TOKEN=
QUALYS_USERNAME=your_username
QUALYS_PASSWORD=your_password

# --- Whose AI tokens Sheldon chat uses ---
#   host = the AWS Bedrock access below pays for every chat
#   user = each person enters their own Anthropic API key or Amazon Bedrock API key
LLM_BILLING=host

# --- AWS Bedrock (used when LLM_BILLING=host) ---
# Keys are optional: if unset, the standard AWS credential chain is used
# (AWS profile / SSO locally, the task IAM role on ECS).
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=ap-south-1
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-5-5   # us.anthropic.claude-haiku-5-5 keeps traffic in the US
