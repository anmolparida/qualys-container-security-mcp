# Copy to params.env and fill in. Used by deploy/aws/deploy.sh.
# (params.env is git-ignored.)

AWS_REGION=ap-south-1
STACK_NAME=qualys-kcs

# --- Network (existing VPC) ---
VPC_ID=vpc-xxxxxxxx
ALB_SUBNET_IDS=subnet-aaaa,subnet-bbbb          # >= 2 AZs
SERVICE_SUBNET_IDS=subnet-cccc,subnet-dddd      # private subnets with NAT recommended
ASSIGN_PUBLIC_IP=DISABLED                       # ENABLED only for public subnets without NAT
ALB_SCHEME=internal                             # or internet-facing
ALLOWED_INGRESS_CIDR=10.0.0.0/8                 # who can reach the ALB (e.g. VPN range)

# --- TLS ---
CERTIFICATE_ARN=arn:aws:acm:ap-south-1:123456789012:certificate/xxxx

# --- Web app: whose Qualys data people see ---
# user    = each person signs in with their own Qualys URL + API token (recommended)
# service = everyone shares one account stored in Secrets Manager (QUALYS_SECRET_NAME)
QUALYS_AUTH_MODE=user
QUALYS_SECRET_NAME=qualys-kcs/web-qualys        # service mode only; created by ./deploy.sh secret

# --- Web app: whose AI tokens Sheldon chat uses ---
# host = this AWS account's Bedrock pays for everyone's chats
# user = each person enters their own Anthropic API key or Amazon Bedrock API key and pays for their own
LLM_BILLING=host
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-5-5   # us.anthropic.claude-haiku-5-5 keeps traffic in the US
BEDROCK_REGION=ap-south-1

# --- MCP server ---
MCP_DEFAULT_QUALYS_URL=                         # optional, e.g. https://gateway.qg2.apps.qualys.com

# --- Optional OIDC sign-in for the web app (leave OIDC_ISSUER blank to disable) ---
OIDC_ISSUER=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_USERINFO_ENDPOINT=
OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET is read from the environment at deploy time (not stored here).
